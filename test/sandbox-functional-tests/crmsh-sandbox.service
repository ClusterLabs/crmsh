[Unit]
Description=crmsh Functional Test Sandbox Service
After=network.target dbus.service
DefaultDependencies=no
Requires=basic.target
After=basic.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/guest-entrypoint.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
